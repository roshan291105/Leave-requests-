# PostgreSQL server shown in pgAdmin. Never commit the real .env file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dayora
PGUSER=postgres
PGPASSWORD=
LEAVE_TIMEZONE=Asia/Kolkata

# postgres_setup.py enables DATABASE_URL after a successful migration.
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/dayora
LEAVE_HOST=0.0.0.0
LEAVE_PORT=5000
LEAVE_DEBUG=0
